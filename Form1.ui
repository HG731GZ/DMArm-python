          <widget class="QPushButton" name="pidHoldButton">
           <property name="enabled"><bool>false</bool></property>
           <property name="text"><string>开启双环持位</string></property>
           <property name="toolTip"><string>锁存当前六轴 MIT 反馈位置。退出持位后继续重力补偿及已开启的力反馈。</string></property>
          </widget>
         </item>
         <item row="3" column="0"><widget class="QPushButton" name="clearButton"><property name="text"><string>整臂清错</string></property><property name="enabled"><bool>false</bool></property></widget></item>
