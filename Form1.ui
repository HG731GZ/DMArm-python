   <string>QMainWindow { background: #f2f5f7; }
QGroupBox { background: white; border: 1px solid #cbd5dc; border-radius: 5px; margin-top: 10px; padding: 9px 4px 3px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; color: #28546a; padding: 0 4px; }
QPushButton { padding: 4px 10px; }
QPushButton#openButton:enabled { background: #22677c; color: white; border: 1px solid #1d5b6d; border-radius: 4px; }
QPushButton#openButton:pressed { background: #184e60; }
QPushButton:disabled { color: #78838a; }
QPlainTextEdit, QTableWidget { background: white; alternate-background-color: #f3f7f8; gridline-color: #e0e7eb; border: 1px solid #d8e0e5; }
