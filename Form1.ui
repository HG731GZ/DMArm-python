        </property>
        <layout class="QGridLayout" name="motorGroupLayout">
         <item row="1" column="3">
          <widget class="QPushButton" name="forceFeedbackButton">
           <property name="enabled"><bool>false</bool></property>
           <property name="text"><string>开启力反馈</string></property>
           <property name="toolTip"><string>六轴 MIT 重力补偿期间，将从端关节净驱动力矩逐轴缩小、反向并限幅后叠加到主端。无效轴的反馈分量为零。</string></property>
          </widget>
         </item>
         <item row="1" column="4">
